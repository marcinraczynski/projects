# K+ Group | Public Affairs
# Blokada dostępu do konfiguracji i bibliotek PHP z przeglądarki.
<FilesMatch "^(config\.php|config\.example\.php|README\.md|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
